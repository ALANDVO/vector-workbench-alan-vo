# Vector Workbench Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEMO_MODE=true
DATABASE_URL=sqlite:///./vector_workbench.sqlite

# Opt-in LLM Provider Settings (Optional advisory only; leave blank for offline deterministic core)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Keycloak OIDC / SSO Settings
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=vector-workbench
KEYCLOAK_CLIENT_ID=vector-workbench-app
KEYCLOAK_CLIENT_SECRET=
JWT_SECRET_KEY=local-dev-jwt-secret-not-for-production
